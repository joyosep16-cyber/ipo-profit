# =========================================================
#  공모주 수익 관리 앱 — 환경 변수 설정 예시
# =========================================================
#
# 이 파일을 복사하여 .env 파일로 저장하고 값을 설정하세요.
# (파일명: .env 로 저장)
#
# =========================================================

# 데이터베이스 (클라우드 PostgreSQL - Neon)
# 로컬과 클라우드가 동일한 데이터베이스를 사용하도록 설정
# 값: postgresql://사용자:비밀번호@호스트/데이터베이스?sslmode=require
DATABASE_URL=postgresql://neondb_owner:비밀번호@ep-cool-boat.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Discord 웹훅 (알림 발송용)
# Discord 채널 설정 → 연동 → 웹후크에서 URL 복사
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/abcdefg

# 고수익 알림 기준 (%)
# 이 수익률 이상이면 Discord 고수익 알림 발송
HIGH_RETURN_THRESHOLD=200

# ngrok 토큰 (모바일 외부 접속용 - 선택사항)
# 토큰 발급: https://dashboard.ngrok.com/authtokens (무료 계정 가능)
# 입력 시 앱 재시작 후 공개 URL이 Discord로 전송됨
NGROK_AUTH_TOKEN=

# 월간 목표 수익 (원)
# 설정 시 앱의 수익 현황 화면에 진행률 바 표시
MONTHLY_GOAL=0

# 연간 목표 수익 (원)
# 설정 시 앱의 수익 현황 화면에 진행률 바 표시
YEARLY_GOAL=0

# =========================================================
#  설정 방법
# =========================================================
#
# 1. 이 파일을 프로젝트 루트에 복사
# 2. 파일명을 ".env" 로 변경
# 3. 각 항목의 비밀번호/URL을 자신의 것으로 교체
# 4. 저장 후 앱 재시작
#
# .env 파일은 Git에 업로드되지 않으므로 안전합니다.
# (로컬 환경 변수만 적용됨)
# =========================================================
